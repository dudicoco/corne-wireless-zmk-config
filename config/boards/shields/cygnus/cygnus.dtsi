/*
 * Cygnus 3x6+3 matrix, taken from
 * https://github.com/Vzhao-L/zmk-for-charybdis/tree/Cygnus-36
 * (RGB/encoders removed). Key order matches the Corne 6-column layout,
 * so the shared main.keymap works unchanged.
 */

#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/foostan/corne/6column.dtsi>

&foostan_corne_6col_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &foostan_corne_6col_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <4>;

        // Right half columns are wired mirrored, hence the reversed order.
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,11) RC(0,10) RC(0,9) RC(0,8) RC(0,7) RC(0,6)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,11) RC(1,10) RC(1,9) RC(1,8) RC(1,7) RC(1,6)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,11) RC(2,10) RC(2,9) RC(2,8) RC(2,7) RC(2,6)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,11) RC(3,10) RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "row2col";
        row-gpios
            = <&pro_micro 6 GPIO_ACTIVE_HIGH>   // P1.00
            , <&pro_micro 7 GPIO_ACTIVE_HIGH>   // P0.11
            , <&pro_micro 8 GPIO_ACTIVE_HIGH>   // P1.04
            , <&pro_micro 9 GPIO_ACTIVE_HIGH>   // P1.06
            ;

        col-gpios
            = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P0.31
            , <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P0.29
            , <&pro_micro 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P0.02
            , <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.15
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.13
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>   // P1.11
            ;
    };
};
